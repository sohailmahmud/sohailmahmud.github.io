          <li>
            <a href="https://www.uctc.edu.bd/ell/profile/2003001" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2 hover:no-underline">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/50 group-hover:bg-emerald-500 transition-colors"></span>
              <span class="font-medium text-zinc-800 group-hover:text-emerald-600:text-emerald-400 transition-colors">Ariful Hasan</span>
            </a>
          </li>
        </ul>
      </div>

