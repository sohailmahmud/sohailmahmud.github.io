              <span class="text-xs text-zinc-500 ml-1">('21-now)</span>
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/sufiah-salim1995" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2 hover:no-underline">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/50 group-hover:bg-emerald-500 transition-colors"></span>
              <span class="font-medium text-zinc-800 group-hover:text-emerald-600:text-emerald-400 transition-colors">Sufiah Salim</span>
              <span class="text-xs text-zinc-500 ml-1">('21-now)</span>
